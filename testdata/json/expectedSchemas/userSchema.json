{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "email", "firstName", "lastName"],
  "properties": {
    "id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "firstName": {
      "type": "string",
      "minLength": 1
    },
    "lastName": {
      "type": "string",
      "minLength": 1
    },
    "phone": {
      "type": ["string", "null"]
    },
    "dateOfBirth": {
      "type": ["string", "null"]
    },
    "gender": {
      "type": ["string", "null"],
      "enum": ["male", "female", "other", null]
    },
    "avatar": {
      "type": ["string", "null"]
    },
    "preferences": {
      "type": "object"
    },
    "isEmailVerified": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
