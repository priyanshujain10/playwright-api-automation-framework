{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "price", "sku", "category"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sku": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "salePrice": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": ["USD", "EUR", "GBP"]
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["size", "color", "sku", "quantity"],
        "properties": {
          "size": { "type": "string" },
          "color": { "type": "string" },
          "sku": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "specifications": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "isActive": {
      "type": "boolean"
    },
    "isFeatured": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}