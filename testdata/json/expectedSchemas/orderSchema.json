{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["orderId", "status", "totalAmount", "shippingAddress", "billingAddress"],
  "properties": {
    "orderId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "processing", "shipped", "delivered", "cancelled", "return_requested"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itemId", "productId", "quantity", "price"],
        "properties": {
          "itemId": { "type": "string" },
          "productId": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "price": { "type": "number", "minimum": 0 },
          "size": { "type": ["string", "null"] },
          "color": { "type": ["string", "null"] }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "minimum": 0
    },
    "tax": {
      "type": "number",
      "minimum": 0
    },
    "shipping": {
      "type": "number",
      "minimum": 0
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0
    },
    "shippingAddress": {
      "type": "object",
      "required": ["firstName", "lastName", "addressLine1", "city", "state", "zipCode", "country"],
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "addressLine1": { "type": "string" },
        "addressLine2": { "type": ["string", "null"] },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zipCode": { "type": "string" },
        "country": { "type": "string" },
        "phone": { "type": ["string", "null"] }
      }
    },
    "billingAddress": {
      "type": "object"
    },
    "paymentMethod": {
      "type": "string"
    },
    "shippingMethod": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
