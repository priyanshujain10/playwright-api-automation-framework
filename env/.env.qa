# Application
TARGET_ENV=qa

# API Configuration
API_BASE_URL=https://api-qa.ecommerce-example.com
API_VERSION=/v1
API_TIMEOUT=30000
SWAGGER_URL=https://api-qa.ecommerce-example.com/index.html

# Authentication
API_TOKEN=
API_KEY=

# Admin Credentials (for setup/teardown)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Test User Credentials
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=

# Feature Flags
ENABLE_PAYMENT_TESTS=true
ENABLE_INVENTORY_TESTS=true

# Database (optional for validation)
DB_HOST=
DB_PORT=5432
DB_NAME=ecommerce_qa
DB_USER=
DB_PASSWORD=