# Pin installed versions exactly in package.json instead of writing a ^ range.
# Ranges still exist for existing deps; this only governs *future* `npm install <pkg>` calls,
# keeping new additions reproducible without relying solely on package-lock.json.
save-exact=true

# Fail fast if a contributor's Node/npm version doesn't satisfy the "engines" field
# in package.json, instead of silently installing on an unsupported runtime.
engine-strict=true

# Keep installs quiet in CI logs; funding nags add noise without value here.
fund=false
